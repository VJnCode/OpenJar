# Copy to .env (git-ignored) and fill in. Docker Compose reads it automatically.
# For running services from the IDE, set the same names as environment variables.
# Generate random secrets with e.g.:  openssl rand -base64 32

# --- Infrastructure ---
MYSQL_ROOT_PASSWORD=change-me
RABBITMQ_USER=openjar
RABBITMQ_PASS=change-me

# --- Auth (user-service <-> api-gateway) ---
OAUTH_CLIENT_SECRET=change-me
# Browser-facing URL of user-service; becomes the "iss" claim every service validates.
AUTH_ISSUER=http://localhost:8086
OAUTH_REDIRECT_URI=http://localhost:8081/login/oauth2/code/openjar-client
FRONTEND_URL=http://localhost:5173
# Optional: persistent JWT signing keys (DER). Without them a fresh key is generated at startup.
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.der
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.der

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:8086/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service-to-service secret for user-service /internal/** ---
INTERNAL_API_TOKEN=change-me

# --- Email (notification-service). Use a Gmail APP PASSWORD, not your real password. ---
MAIL_USER=you@example.com
MAIL_PASS=change-me

# --- recommendation-service ---
GOOGLE_GENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=openjar-index
